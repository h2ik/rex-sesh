#!/usr/bin/env zsh
# REX SESSION PICKER. SESH CLONE FOR REX.
# USAGE: rex-sesh [CLIENT_ID] [ORIGIN_SESSION_ID]
# INIT.LUA ACTION sesh_picker STARTS THIS IN A FLOATING LAYER.

emulate -L zsh
setopt pipefail

# FIND REX BINARY. TERMINAL ENV FIRST, THEN PATH, THEN APP BUNDLE.
REX=""
if [[ -n "$REX_BIN_DIR" && -x "$REX_BIN_DIR/rex" ]]; then
  REX="$REX_BIN_DIR/rex"
elif (( $+commands[rex] )); then
  REX="rex"
else
  for app in "/Applications/Rex Beta.app" "/Applications/Rex.app"; do
    if [[ -x "$app/Contents/Helpers/Rex Server.rex/Contents/MacOS/rex" ]]; then
      REX="$app/Contents/Helpers/Rex Server.rex/Contents/MacOS/rex"
      break
    fi
  done
fi
if [[ -z "$REX" ]]; then
  print -u2 "rex-sesh: REX CLI NOT FOUND."
  exit 1
fi

SELF="${0:A}"
TAB=$'\t'

# ROW FORMAT: KIND <TAB> ID <TAB> DISPLAY. KIND IS s (SESSION) OR d (DIRECTORY).

# SESSION NAME FOR DIR. BASENAME, DOTS TO UNDERSCORES.
session_name() {
  local dir="${1/#\~/$HOME}"
  print -r -- "${${dir:t}//./_}"
}

# SESSION JSON. ONE ROW PER SESSION WITH TOP PROGRAM STATE (OSC 7501).
# STATE RANK: blocked > error > done > working > idle. EMPTY IF NO REPORT.
session_json() {
  "$REX" do - <<'LUA'
local term = "com.superlogical.terminal.program_status"
local rank = { idle = 1, working = 2, done = 3, error = 4, blocked = 5 }
local list, err = rex.call("session.list")
if list == nil then error(err, 0) end
local out = {}
for _, s in ipairs(list.sessions or {}) do
  local best, best_rank = "", 0
  -- ATTACH. STATUS CALL FAILS ON SESSION NOT ATTACHED.
  local at = rex.session.attach{ session_id = s.session_id }
  local view = at and at.view or {}
  for _, w in ipairs(view.windows or {}) do
    for _, l in ipairs(w.layers or {}) do
      for _, b in ipairs(l.blocks or {}) do
        if b.creator_name == "com.superlogical.terminal" then
          local st = rex.call(term, { session_id = s.session_id, block_id = b.block_id })
          for _, r in ipairs((st or {}).records or {}) do
            local n = rank[r.state] or 1
            if n > best_rank then best, best_rank = r.state, n end
          end
        end
      end
    end
  end
  rex.session.detach{ session_id = s.session_id }
  table.insert(out, { session_id = s.session_id, label = s.label, state = best })
end
return out
LUA
}

# SESSION ROWS FROM SESSION JSON. COLOR DOT AFTER LABEL.
# YELLOW: BLOCKED. RED: ERROR. GREEN: DONE. BLUE: WORKING.
# SORT ORDER: ORIGIN, BLOCKED, ERROR, DONE, IDLE, WORKING, NO REPORT.
# SORT IS STABLE. SESSION.LIST ORDER STAYS IN EACH GROUP.
session_rows() {
  jq -r --arg origin "$REX_SESH_ORIGIN" '
    def order:
      if   (.session_id | ltrimstr("session:")) == ($origin | ltrimstr("session:")) then 0
      elif .state == "blocked"    then 1
      elif .state == "error"      then 2
      elif .state == "done"       then 3
      elif .state == "idle"       then 4
      elif .state == "working"    then 5
      else 6 end;
    def dot:
      if   . == "blocked" then " \u001b[33m●\u001b[0m"
      elif . == "error"   then " \u001b[31m●\u001b[0m"
      elif . == "done"    then " \u001b[32m●\u001b[0m"
      elif . == "working" then " \u001b[34m●\u001b[0m"
      else "" end;
    sort_by(order) | .[] | "s\t\(.session_id)\t🪟  \(.label)\(.state | dot)"'
}

list_sessions() {
  session_json | session_rows
}

# ALL ROWS. SESSIONS FIRST. DROP DIR ROWS THAT MATCH A SESSION LABEL.
list_all() {
  local json label kind id display
  local -A taken
  json=$(session_json)
  for label in ${(f)"$(jq -r '.[].label' <<<"$json")"}; do
    taken[$label]=1
  done
  session_rows <<<"$json"
  { list_configs; list_zoxide } | while IFS=$TAB read -r kind id display; do
    (( ${+taken[$(session_name "$id")]} )) || print -r -- "${kind}${TAB}${id}${TAB}${display}"
  done
}

list_configs() {
  sesh list -c --json 2>/dev/null | jq -r '.[]? | "d\t\(.Path)\t⚙️  \(.Name)"'
}

list_dirs() {
  local dir
  while IFS= read -r dir; do
    print -r -- "d${TAB}${dir}${TAB}📁  ${dir/#$HOME/~}"
  done
}

list_zoxide() {
  zoxide query -l 2>/dev/null | list_dirs
}

list_find() {
  fd -H -d 2 -t d -E .Trash . ~ 2>/dev/null | sed 's:/$::' | list_dirs
}

do_list() {
  case "$1" in
    sessions) list_sessions ;;
    configs)  list_configs ;;
    zoxide)   list_zoxide ;;
    find)     list_find ;;
    *)        list_all ;;
  esac
}

do_preview() {
  local kind="$1" id="$2"
  if [[ "$kind" == s ]]; then
    # PREVIEW SESSION. CAPTURE FOCUSED BLOCK OF ACTIVE WINDOW.
    # FOCUSED BLOCK IN FLOATING LAYER (PICKER FLOAT): USE FIRST TILED BLOCK.
    local block
    block=$("$REX" session inspect "$id" --json | jq -r '
      .active_window_id as $w
      | .windows[] | select(.window_id == $w)
      | [.layers[] | select(.kind == "tiled") | .blocks[].block_id] as $tiled
      | if (.focused_block_id as $f | $tiled | index($f)) then .focused_block_id
        else ($tiled[0] // empty) end')
    if [[ -n "$block" && "$block" != null ]]; then
      "$REX" capture -s "$id" -b "$block" --trim --format=vt | tail -n "${FZF_PREVIEW_LINES:-40}"
    else
      print "NO FOCUSED BLOCK."
    fi
  else
    # PREVIEW DIRECTORY. LIST CONTENTS.
    eza -la --icons=always --color=always --group-directories-first "$id" 2>/dev/null || ls -la "$id"
  fi
}

do_kill() {
  local kind="$1" id="$2"
  [[ "$kind" == s ]] || return 0
  # DO NOT KILL ORIGIN SESSION. PICKER LIVES THERE.
  [[ "$id" == "$REX_SESH_ORIGIN" ]] && return 0
  "$REX" kill "$id" >/dev/null 2>&1
}

select_session() {
  local id="$1"
  if [[ -n "$REX_SESH_CLIENT" ]]; then
    "$REX" -C "$REX_SESH_CLIENT" do session.select session_id="$id"
  else
    "$REX" do session.select session_id="$id"
  fi
}

do_connect() {
  local kind="$1" id="$2"
  if [[ "$kind" == d ]]; then
    local dir="${id/#\~/$HOME}"
    local name
    name=$(session_name "$dir")
    # FIND SESSION WITH SAME LABEL. IF NONE, MAKE NEW SESSION IN DIR.
    id=$("$REX" ls --json | jq -r --arg n "$name" \
      'first(.sessions[] | select(.label == $n) | .session_id) // empty')
    if [[ -z "$id" ]]; then
      id=$("$REX" new "$name" -c "$dir" --json | jq -r '.session_id') || return 1
    fi
  fi
  select_session "$id"
}

pick() {
  local header='  ^a all ^t rex ^g configs ^x zoxide ^d rex kill ^f find'
  do_list all | fzf \
    --no-sort --ansi --border-label ' sesh ' --prompt '⚡  ' \
    --delimiter "$TAB" --with-nth 3 \
    --header "$header" \
    --bind 'tab:down,btab:up' \
    --bind "ctrl-a:change-prompt(⚡  )+reload('$SELF' list all)" \
    --bind "ctrl-t:change-prompt(🪟  )+reload('$SELF' list sessions)" \
    --bind "ctrl-g:change-prompt(⚙️  )+reload('$SELF' list configs)" \
    --bind "ctrl-x:change-prompt(📁  )+reload('$SELF' list zoxide)" \
    --bind "ctrl-f:change-prompt(🔎  )+reload('$SELF' list find)" \
    --bind "ctrl-d:execute-silent('$SELF' kill {1} {2})+change-prompt(⚡  )+reload('$SELF' list all)" \
    --preview-window 'right:55%' \
    --preview "'$SELF' preview {1} {2}"
}

main() {
  case "$1" in
    list)    do_list "$2"; return ;;
    preview) do_preview "$2" "$3"; return ;;
    kill)    do_kill "$2" "$3"; return ;;
  esac

  # TOP LEVEL. STORE CLIENT AND ORIGIN FOR SUBCOMMANDS.
  export REX_SESH_CLIENT="$1"
  export REX_SESH_ORIGIN="$2"

  local row kind id
  row=$(pick) || return 0
  kind="${row%%$TAB*}"
  id="${${row#*$TAB}%%$TAB*}"

  if ! do_connect "$kind" "$id"; then
    # SHOW ERROR. HOLD FLOAT OPEN UNTIL KEY PRESS.
    print -P "%F{red}CONNECT FAILED. CHECK REMOTE CONTROL IN REX SETTINGS.%f"
    read -k1 "?PRESS ANY KEY."
  fi
}

main "$@"
